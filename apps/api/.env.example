NODE_ENV=development
PORT=5000

# Comma-separated list of browser origins allowed to call the API
CORS_ORIGINS=http://localhost:3000

# Signs login tokens. Use a long random value, for example: openssl rand -base64 48
JWT_SECRET=

# Neon Postgres: pooled URL for the app, direct URL for migrations
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# A separate Neon branch for tests. Tests delete data, so never use the main database here.
TEST_DATABASE_URL=
TEST_DATABASE_URL_UNPOOLED=

# MongoDB Atlas
MONGODB_URI=

# Optional: Redis for rate limits and caching shared by every server process.
# Without it, both are kept in memory, which is fine for a single server.
REDIS_URL=
CACHE_ENABLED=true
RATE_LIMIT_ENABLED=true

# Hosts the gateway may forward to (prevents server-side request forgery)
UPSTREAM_ALLOWED_HOSTS=localhost,127.0.0.1
# Proxies in front of the app: 1 on most hosting platforms, 0 locally
TRUST_PROXY_HOPS=0
