NODE_ENV=development
PORT=5000

# Comma-separated list of browser origins allowed to call the API
CORS_ORIGINS=http://localhost:3000

# Signs login tokens. Use a long random value, for example: openssl rand -base64 48
JWT_SECRET=

# Neon Postgres: pooled URL for the app, direct URL for migrations
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# A separate Neon branch for tests. Tests delete data, so never use the main database here.
TEST_DATABASE_URL=
TEST_DATABASE_URL_UNPOOLED=

# MongoDB Atlas
MONGODB_URI=
