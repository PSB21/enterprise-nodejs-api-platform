generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

// The connection URL lives in prisma.config.ts (migrations) and src/db/prisma.ts (the app).
datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  PUBLISHER
  DEVELOPER
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  name         String   @db.VarChar(100)
  // The app stores emails in lowercase, so this also blocks duplicates that differ only by case.
  email        String   @unique @db.VarChar(254)
  passwordHash String   @map("password_hash")
  role         Role     @default(DEVELOPER)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz

  refreshTokens RefreshToken[]

  @@map("users")
}

/// One row per refresh token ever issued. Only a hash is stored, so a database leak does not
/// hand out working sessions. Tokens from one login share a familyId, so if an old token is
/// reused (a sign it was stolen) the whole family can be revoked at once.
model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  familyId  String    @map("family_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz

  @@index([familyId])
  @@index([userId])
  @@map("refresh_tokens")
}

/// An append-only record of who did what, written by the event worker. There is deliberately
/// no foreign key to users: the record must survive even if the account is deleted.
model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  // The event's own id. Unique, so handling the same event twice records it once.
  eventId     String   @unique @map("event_id") @db.Uuid
  type        String   @db.VarChar(100)
  actorId     String?  @map("actor_id") @db.Uuid
  subjectType String   @map("subject_type") @db.VarChar(50)
  subjectId   String   @map("subject_id") @db.VarChar(100)
  data        Json     @default("{}")
  occurredAt  DateTime @map("occurred_at") @db.Timestamptz
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([type, occurredAt(sort: Desc)])
  @@index([subjectType, subjectId])
  @@index([occurredAt(sort: Desc)])
  @@map("audit_logs")
}
