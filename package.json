{
  "name": "api-management-system",
  "version": "1.0.0",
  "private": true,
  "description": "API management platform: publish APIs, approve access, issue keys and track usage.",
  "license": "ISC",
  "engines": {
    "node": ">=24.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@ams/api",
    "dev:web": "npm run dev --workspace=@ams/web",
    "build": "npm run build --workspaces",
    "start": "npm run start --workspace=@ams/api",
    "test": "npm run test --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "typescript-eslint": "^8.72.1"
  }
}
